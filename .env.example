# 院内 PaddleOCR 服务根地址；服务端需要提供 POST /ocr/medical-record。
VITE_OCR_API_BASE_URL=https://ocr.example-hospital.local

# 医护 Web 共用 FastAPI。浏览器开发留空并使用 Vite 代理；Android 默认连接测试服务器。
# 生产环境应显式配置为 HTTPS/WSS 网关地址。
VITE_REHAB_API_BASE_URL=
VITE_REHAB_HOSPITAL_ID=10001

# 可选：后端正式提供 Pad/患者访问令牌后配置。不要把真实令牌提交到 Git。
VITE_PAD_API_TOKEN=
